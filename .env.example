# =============================================================================
# Applyuminati -- example environment file
# =============================================================================
#
#   #####################################################################
#   #  THIS FILE IS COMMITTED TO GIT. IT MUST NEVER CONTAIN A REAL      #
#   #  SECRET. Every key, password and token below is an empty          #
#   #  placeholder or an obvious dummy. Copy it to `.env` and put your  #
#   #  real values THERE -- `.env` is gitignored, this file is not.     #
#   #####################################################################
#
#       cp .env.example .env
#
# HOW CONFIGURATION IS RESOLVED (strongest first):
#   1. explicit arguments (CLI flags, tests)
#   2. environment variables -- everything in this file
#   3. a `.env` file in the working directory
#   4. `config.toml` inside the data directory
#   5. field defaults
#
# NAMING RULES, they are mechanical:
#   * every variable starts with `APPLYUMINATI_`
#   * nesting uses a DOUBLE underscore: `APPLYUMINATI_SERVER__PORT` sets
#     `settings.server.port`
#   * names are case-insensitive; dictionary key segments (a provider name, an
#     email account name, a source slug) are lowercased, so
#     `...PROVIDERS__OpenAI__API_KEY` and `...PROVIDERS__OPENAI__API_KEY` both
#     define the provider named `openai`
#   * list and dict values are parsed as JSON, so quote them as JSON:
#     `APPLYUMINATI_BROWSER__PREFERRED='["playwright"]'`
#   * booleans accept true/false/1/0
#
# Every variable below is OPTIONAL. Applyuminati runs with none of them set.
# Uncommented lines are the ones worth setting deliberately.
# =============================================================================


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

# Everything local lives here: the SQLite database, generated documents,
# captured artifacts, logs and config.toml. Default: ~/.applyuminati
# The Docker image sets this to /data and mounts a volume there.
#APPLYUMINATI_DATA_DIR=~/.applyuminati

# Optional override for where files a site sent us are written.
# Default: <data_dir>/downloads. Relative paths resolve against data_dir.
#APPLYUMINATI_DOWNLOADS_PATH=

# Overrides the derived SQLite URL. Leave unset unless you are deliberately
# moving off SQLite; the dialect must be one SQLAlchemy supports.
# Default: sqlite+pysqlite:///<data_dir>/applyuminati.db
#APPLYUMINATI_DATABASE_URL=postgresql+psycopg://user:password@localhost/applyuminati


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# One of: local | docker | ci. Affects defaults and diagnostics only.
#APPLYUMINATI_ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
#APPLYUMINATI_LOG_LEVEL=INFO

# console (human-readable, the default) | json (for log shippers)
#APPLYUMINATI_LOG_FORMAT=console

# HOW FAR THE SYSTEM MAY GO WITHOUT ASKING YOU. Read this one.
#   research_only        find, score and research jobs. Never fills a form.
#                        The default, and the only one that cannot act.
#   prepare_application  additionally drafts resumes, letters and answers.
#   fill_no_submit       additionally fills real application forms and stops
#                        at the submit button for your review.
#   autonomous_submit    additionally presses submit. Fully supported, never
#                        the default. Enabling it is a deliberate act and
#                        requires at least one browser backend.
#APPLYUMINATI_EXECUTION_MODE=research_only


# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------

# Default 127.0.0.1: reachable only from this machine. Use 0.0.0.0 to expose it
# on your network -- and note there is no authentication in front of it.
# The Docker image sets 0.0.0.0, because a container-local bind is unreachable.
#APPLYUMINATI_SERVER__HOST=127.0.0.1
#APPLYUMINATI_SERVER__PORT=8000

# Extra browser origins allowed to call the API, as a JSON array. The bundled
# UI is served from the same origin as the API, so this stays empty in normal
# and Docker deployments. Only needed when running the UI on a different host.
#APPLYUMINATI_SERVER__CORS_ORIGINS='["http://localhost:5173"]'

# Directory of built web assets, served at "/" when present. The Docker image
# sets /app/web. Locally, point it at apps/web/dist after `npm run build` to
# serve the UI from the API instead of running the Vite dev server.
#APPLYUMINATI_SERVER__WEB_DIST=apps/web/dist


# -----------------------------------------------------------------------------
# LLM -- global switches
# -----------------------------------------------------------------------------

# false disables every optional LLM pass and falls back to deterministic
# behaviour. The system stays fully usable offline; scoring just loses its
# qualitative layer. Leaving this true with no provider configured is safe.
#APPLYUMINATI_LLM__ENABLED=true

# Which entry in PROVIDERS to use by default.
# WARNING: naming a provider you have not configured is a startup error, by
# design -- a silent fallback to "no LLM" is worse than a loud failure. With
# exactly one enabled provider this is inferred and can be left unset.
#APPLYUMINATI_LLM__DEFAULT_PROVIDER=openai

# Hard spend ceiling per discovery/scoring run, in USD. Unset means no limit.
#APPLYUMINATI_LLM__RUN_BUDGET_USD=5.00


# -----------------------------------------------------------------------------
# LLM -- providers
# -----------------------------------------------------------------------------
#
# A provider is a named block. `openai` in the examples below is just a label
# you chose; the segment after PROVIDERS__ becomes its name.
#
# Available per-provider settings:
#   KIND                    adapter to use. openai_compatible | anthropic | gemini
#   ENABLED                 default true
#   BASE_URL                API root
#   API_KEY                 secret; never logged or returned by the API
#   DEFAULT_MODEL           model used when a task does not ask for one
#   FAST_MODEL              cheaper model for high-volume classification work
#   INPUT_COST_PER_MTOK     USD per 1M input tokens, for cost estimation only
#   OUTPUT_COST_PER_MTOK    USD per 1M output tokens
#   TIMEOUT_SECONDS         default 120
#   MAX_RETRIES             default 2
#   EXTRA_HEADERS           JSON object of additional request headers
#
# OpenAI, OpenRouter, Ollama, vLLM, LM Studio and most self-hosted gateways all
# speak the same wire format, so they are all `openai_compatible` with a
# different BASE_URL. Configure as many providers as you like; only the one
# named by DEFAULT_PROVIDER is used unless a task asks otherwise.

# --- OpenAI ------------------------------------------------------------------
#APPLYUMINATI_LLM__DEFAULT_PROVIDER=openai
#APPLYUMINATI_LLM__PROVIDERS__OPENAI__KIND=openai_compatible
#APPLYUMINATI_LLM__PROVIDERS__OPENAI__BASE_URL=https://api.openai.com/v1
#APPLYUMINATI_LLM__PROVIDERS__OPENAI__API_KEY=
#APPLYUMINATI_LLM__PROVIDERS__OPENAI__DEFAULT_MODEL=gpt-4o
#APPLYUMINATI_LLM__PROVIDERS__OPENAI__FAST_MODEL=gpt-4o-mini
#APPLYUMINATI_LLM__PROVIDERS__OPENAI__INPUT_COST_PER_MTOK=2.50
#APPLYUMINATI_LLM__PROVIDERS__OPENAI__OUTPUT_COST_PER_MTOK=10.00

# --- OpenRouter (one key, many vendors) --------------------------------------
# EXTRA_HEADERS is optional and only affects OpenRouter's attribution ranking.
#APPLYUMINATI_LLM__DEFAULT_PROVIDER=openrouter
#APPLYUMINATI_LLM__PROVIDERS__OPENROUTER__KIND=openai_compatible
#APPLYUMINATI_LLM__PROVIDERS__OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
#APPLYUMINATI_LLM__PROVIDERS__OPENROUTER__API_KEY=
#APPLYUMINATI_LLM__PROVIDERS__OPENROUTER__DEFAULT_MODEL=anthropic/claude-sonnet-4
#APPLYUMINATI_LLM__PROVIDERS__OPENROUTER__FAST_MODEL=openai/gpt-4o-mini
#APPLYUMINATI_LLM__PROVIDERS__OPENROUTER__EXTRA_HEADERS='{"HTTP-Referer":"https://github.com/spencerthayer/Applyuminati","X-Title":"Applyuminati"}'

# --- Anthropic ---------------------------------------------------------------
# Native adapter, not openai_compatible: Anthropic's wire format differs.
#APPLYUMINATI_LLM__DEFAULT_PROVIDER=anthropic
#APPLYUMINATI_LLM__PROVIDERS__ANTHROPIC__KIND=anthropic
#APPLYUMINATI_LLM__PROVIDERS__ANTHROPIC__BASE_URL=https://api.anthropic.com
#APPLYUMINATI_LLM__PROVIDERS__ANTHROPIC__API_KEY=
#APPLYUMINATI_LLM__PROVIDERS__ANTHROPIC__DEFAULT_MODEL=claude-sonnet-4-20250514
#APPLYUMINATI_LLM__PROVIDERS__ANTHROPIC__FAST_MODEL=claude-3-5-haiku-latest

# --- Google Gemini -----------------------------------------------------------
#APPLYUMINATI_LLM__DEFAULT_PROVIDER=gemini
#APPLYUMINATI_LLM__PROVIDERS__GEMINI__KIND=gemini
#APPLYUMINATI_LLM__PROVIDERS__GEMINI__BASE_URL=https://generativelanguage.googleapis.com
#APPLYUMINATI_LLM__PROVIDERS__GEMINI__API_KEY=
#APPLYUMINATI_LLM__PROVIDERS__GEMINI__DEFAULT_MODEL=gemini-2.5-pro
#APPLYUMINATI_LLM__PROVIDERS__GEMINI__FAST_MODEL=gemini-2.5-flash

# --- Ollama (local, free, no key) --------------------------------------------
# Run `ollama pull llama3.1:8b` first. API_KEY is required by the wire format
# but ignored by Ollama, so any placeholder works.
# From inside a container use http://host.docker.internal:11434/v1 instead.
#APPLYUMINATI_LLM__DEFAULT_PROVIDER=ollama
#APPLYUMINATI_LLM__PROVIDERS__OLLAMA__KIND=openai_compatible
#APPLYUMINATI_LLM__PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434/v1
#APPLYUMINATI_LLM__PROVIDERS__OLLAMA__API_KEY=ollama
#APPLYUMINATI_LLM__PROVIDERS__OLLAMA__DEFAULT_MODEL=llama3.1:8b
#APPLYUMINATI_LLM__PROVIDERS__OLLAMA__TIMEOUT_SECONDS=300


# -----------------------------------------------------------------------------
# Job discovery
# -----------------------------------------------------------------------------

# Politeness floor applied on top of each plugin's own rate limit. Lowering it
# gets you blocked; that is the tradeoff.
#APPLYUMINATI_DISCOVERY__MIN_REQUEST_INTERVAL_SECONDS=0.5
#APPLYUMINATI_DISCOVERY__REQUEST_TIMEOUT_SECONDS=30.0
#APPLYUMINATI_DISCOVERY__RESPECT_ROBOTS_TXT=true

# Sent on every outbound request. Keep it honest and identifiable.
#APPLYUMINATI_DISCOVERY__USER_AGENT='Applyuminati/0.1 (+https://github.com/spencerthayer/Applyuminati) local-first job search'

# Per-source enablement. Sources are OFF by default: you opt in to each one.
# OPTIONS is a JSON object whose shape each source plugin defines and validates.
#APPLYUMINATI_DISCOVERY__SOURCES__GREENHOUSE__ENABLED=true
#APPLYUMINATI_DISCOVERY__SOURCES__GREENHOUSE__OPTIONS='{"boards":["stripe","figma"]}'
#APPLYUMINATI_DISCOVERY__SOURCES__LEVER__ENABLED=true
#APPLYUMINATI_DISCOVERY__SOURCES__LEVER__OPTIONS='{"companies":["netflix"]}'
# local_feed reads jobs from a file on disk. Needs no network, which makes it
# the right source for trying the system out.
#APPLYUMINATI_DISCOVERY__SOURCES__LOCAL_FEED__ENABLED=true
#APPLYUMINATI_DISCOVERY__SOURCES__LOCAL_FEED__OPTIONS='{"path":"~/.applyuminati/feed.json"}'


# -----------------------------------------------------------------------------
# Browser automation
# -----------------------------------------------------------------------------

# Ordered preference; the first AVAILABLE backend wins, so a host without ego
# lite falls back to Playwright with no configuration change. JSON array.
#APPLYUMINATI_BROWSER__PREFERRED='["ego_lite","playwright"]'

# false shows a real window -- the only sane way to watch a form being filled.
#APPLYUMINATI_BROWSER__HEADLESS=true

# Absolute path to the ego-browser helper. Discovered on PATH and inside the
# "ego lite.app" bundle when unset.
#APPLYUMINATI_BROWSER__EGO_LITE_BINARY=/usr/local/bin/ego-browser

# Where ego lite loads per-site helper packs from.
# Default: <data_dir>/ego-workspace
#APPLYUMINATI_BROWSER__EGO_LITE_WORKSPACE=

# Playwright storage_state path, so site logins survive between runs. Treat
# the files it names as a credential: they contain live session cookies.
# Relative paths resolve against data_dir, not the process working directory.
# First run with the path configured and no file yet is expected.
#APPLYUMINATI_BROWSER__PLAYWRIGHT_STORAGE_STATE=

# Playwright launch proxy. Credentials belong in the dedicated fields, not in
# the server URL. Accepted schemes: http, https, socks5.
#APPLYUMINATI_BROWSER__PLAYWRIGHT_PROXY__SERVER=
#APPLYUMINATI_BROWSER__PLAYWRIGHT_PROXY__USERNAME=
#APPLYUMINATI_BROWSER__PLAYWRIGHT_PROXY__PASSWORD=
#APPLYUMINATI_BROWSER__PLAYWRIGHT_PROXY__BYPASS=

# Which Playwright-supported browser channel to launch (for example chrome or
# msedge). Selects a binary. It does not reuse a human Chrome profile.
#APPLYUMINATI_BROWSER__PLAYWRIGHT_CHANNEL=

# Absolute path, interpreted inside the process or container running
# Playwright, to the browser executable. A macOS host path will not resolve
# inside a Linux container. Mutually exclusive with PLAYWRIGHT_CHANNEL.
#APPLYUMINATI_BROWSER__PLAYWRIGHT_EXECUTABLE_PATH=

#APPLYUMINATI_BROWSER__NAVIGATION_TIMEOUT_SECONDS=45.0

# Screenshots and DOM captures per application attempt. Your audit trail of
# what was actually submitted on your behalf; keep it on.
#APPLYUMINATI_BROWSER__CAPTURE_ARTIFACTS=true


# -----------------------------------------------------------------------------
# External agent runtimes (optional)
# -----------------------------------------------------------------------------

# Off by default. These delegate open-ended work to a coding-agent CLI that
# must already be installed and authenticated on this machine.
#APPLYUMINATI_AGENTS__ENABLED=false

# Ordered preference; JSON array. Known slugs: oh_my_pi, codex, claude_code,
# opencode, pi.
#APPLYUMINATI_AGENTS__PREFERRED='["oh_my_pi","codex","claude_code"]'
#APPLYUMINATI_AGENTS__DEFAULT_TIMEOUT_SECONDS=600.0

# Executable overrides, keyed by backend slug, for binaries not on PATH.
#APPLYUMINATI_AGENTS__BINARIES__CODEX=/opt/homebrew/bin/codex
#APPLYUMINATI_AGENTS__BINARIES__CLAUDE_CODE=/opt/homebrew/bin/claude


# -----------------------------------------------------------------------------
# Email (optional) -- tracking recruiter replies and interview invitations
# -----------------------------------------------------------------------------
#
# `personal` below is a label you chose. Per-account settings: KIND, ENABLED,
# HOST, PORT, USERNAME, PASSWORD, USE_SSL, MAILBOX.
#
# Use a provider-issued APP PASSWORD, never your account password. For Gmail
# this requires 2FA and an app password from your Google account settings.
#APPLYUMINATI_EMAIL__ACCOUNTS__PERSONAL__KIND=imap
#APPLYUMINATI_EMAIL__ACCOUNTS__PERSONAL__ENABLED=true
#APPLYUMINATI_EMAIL__ACCOUNTS__PERSONAL__HOST=imap.gmail.com
#APPLYUMINATI_EMAIL__ACCOUNTS__PERSONAL__PORT=993
#APPLYUMINATI_EMAIL__ACCOUNTS__PERSONAL__USERNAME=you@example.com
#APPLYUMINATI_EMAIL__ACCOUNTS__PERSONAL__PASSWORD=
#APPLYUMINATI_EMAIL__ACCOUNTS__PERSONAL__USE_SSL=true
#APPLYUMINATI_EMAIL__ACCOUNTS__PERSONAL__MAILBOX=INBOX


# =============================================================================
# Docker / compose variables
# =============================================================================
#
# These are NOT application settings -- they are read by docker-compose.yml and
# docker-compose.dev.yml themselves, and are meaningless to the application.
# Portainer users set these in the stack's "Environment variables" panel.

# Image tag to deploy. `latest` tracks main; pin a semver for stability.
#APPLYUMINATI_TAG=latest

# Host port for the deployable stack. The UI and API are both served here.
#APPLYUMINATI_PORT=8420

# Port inside the container. Drives the app, the published mapping and the
# healthcheck together, so they cannot drift. Rarely worth changing.
#APPLYUMINATI_INTERNAL_PORT=8000

#APPLYUMINATI_CONTAINER_NAME=applyuminati
#APPLYUMINATI_VOLUME_NAME=applyuminati-data

# docker-compose.dev.yml only.
#APPLYUMINATI_DEV_API_PORT=8000
#APPLYUMINATI_DEV_WEB_PORT=5173
# Vite dev-server proxy target. Only affects `vite dev`, never the built bundle.
#APPLYUMINATI_DEV_PROXY_TARGET=http://127.0.0.1:8000
